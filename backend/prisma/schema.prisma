generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model campoextra {
  id       Int    @id @default(autoincrement())
  deudorId Int
  clave    String
  valor    String
  deudor   deudor @relation(fields: [deudorId], references: [id], map: "CampoExtra_deudorId_fkey")

  @@index([deudorId], map: "CampoExtra_deudorId_fkey")
}

model comentario {
  id        Int      @id @default(autoincrement())
  deudorId  Int
  usuarioId Int?
  fecha     DateTime @default(now())
  texto     String
  origen    String?
  deudor    deudor   @relation(fields: [deudorId], references: [id], map: "Comentario_deudorId_fkey")
  usuario   usuario? @relation(fields: [usuarioId], references: [id], map: "Comentario_usuarioId_fkey")

  @@index([deudorId], map: "Comentario_deudorId_fkey")
  @@index([usuarioId], map: "Comentario_usuarioId_fkey")
  @@index([fecha], map: "Comentario_fecha_idx")
  @@index([deudorId, fecha], map: "Comentario_deudorId_fecha_idx")
}

model contacto {
  id        Int     @id @default(autoincrement())
  deudorId  Int
  tipo      String
  valor     String
  prioridad Int?
  validado  Boolean @default(false)
  subtipo   String?
  whatsapp  Boolean @default(false)
  deudor    deudor  @relation(fields: [deudorId], references: [id], map: "Contacto_deudorId_fkey")
  llamadas  llamada_neotel[]

  @@unique([deudorId, tipo, valor], map: "Contacto_deudorId_tipo_valor_key")
  @@index([deudorId, tipo], map: "Contacto_deudorId_tipo_idx")
}

model deudor {
  id                Int           @id @default(autoincrement())
  empresaId         Int
  remesaId          Int
  documento         String
  nroCliente        String?
  nombre            String
  apellido          String
  montoTotal             Float?
  saldo                  Float?        // Persistido por ConsolidacionSituacionService. Ver consolidacion-situacion-spec.md §2.
  situacionConsolidadaEn DateTime?     // Timestamp de la última consolidación.
  fechaVencimiento       DateTime?
  estadoSituacionId      Int?
  estadoGestionId        Int?
  // Guarda el estadoGestionId previo cuando el deudor se DESASIGNA (GES-094) por una
  // actualización diaria de gestión, para poder revertir la desasignación si reaparece.
  // null salvo mientras esté desasignado. Ver imports-actualizacion-diaria-*-spec.md (Feature A).
  estadoGestionPrevioAId Int?
  motivoNoPagoId         Int?
  camposAdicionales      Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  campoExtras       campoextra[]
  comentarios       comentario[]
  contactos         contacto[]
  empresa           empresa       @relation(fields: [empresaId], references: [id], map: "Deudor_empresaId_fkey")
  remesa            remesa        @relation(fields: [remesaId], references: [id], map: "Deudor_remesaId_fkey")
  estadoGestion     parametro?    @relation("DeudorEstadoGestion", fields: [estadoGestionId], references: [id])
  estadoGestionPrevio parametro?  @relation("DeudorEstadoGestionPrevio", fields: [estadoGestionPrevioAId], references: [id])
  estadoSituacion   parametro?    @relation("DeudorEstadoSituacion", fields: [estadoSituacionId], references: [id])
  motivoNoPago      parametro?    @relation("DeudorMotivoNoPago", fields: [motivoNoPagoId], references: [id])
  facturas          factura[]
  pagos             pago[]
  promesas          promesa_pago[]
  transacciones     transaccion[]
  convenios         convenio[]
  enviosEmail       envio_email[]
  llamadas          llamada_neotel[]

  @@unique([empresaId, documento, remesaId], map: "Deudor_empresaId_documento_remesaId_key")
  @@index([documento], map: "Deudor_documento_idx")
  @@index([empresaId, remesaId], map: "Deudor_empresaId_remesaId_idx")
  @@index([empresaId, remesaId, nroCliente], map: "Deudor_empresaId_remesaId_nroCliente_idx")
  @@index([fechaVencimiento], map: "Deudor_fechaVencimiento_idx")
  @@index([estadoGestionId], map: "Deudor_estadoGestionId_fkey")
  @@index([estadoGestionPrevioAId], map: "Deudor_estadoGestionPrevioAId_idx")
  @@index([estadoSituacionId], map: "Deudor_estadoSituacionId_fkey")
  @@index([estadoSituacionId, empresaId], map: "Deudor_estadoSituacion_empresa_idx")
  @@index([motivoNoPagoId], map: "Deudor_motivoNoPagoId_fkey")
  @@index([remesaId], map: "Deudor_remesaId_fkey")
}

model empresa {
  id              Int                 @id @default(autoincrement())
  nombre          String              @unique(map: "Empresa_nombre_key")
  cuit            String?
  configuracion   Json?
  cuentaSmtpId    Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deudor          deudor[]
  parametro       empresa_parametro[]
  plantillaimport plantillaimport[]
  remesa          remesa[]
  politicas       politica[]
  plantillas      plantilla_reporte[] @relation("PlantillaEmpresa")
  transaccion     transaccion[]
  enviosEmail     envio_email[]
  campañasNeotel  campaña_neotel[]
}

model factura {
  id           Int      @id @default(autoincrement())
  deudorId     Int
  nroFactura   String
  importe      Float
  fechaEmision DateTime
  vencimiento  DateTime
  estado       String?
  // Identificador de la factura en el sistema del cedente. En MULTIRREGISTRO (Toyota 87) guarda
  // el nro de CONTRATO al que pertenece el aviso.
  externalId   String?
  // Desglose de los conceptos que componen el importe, en texto. Lo usa MULTIRREGISTRO para volcar
  // los registros DET del aviso (multas, honorarios, IVA, días de mora). Ver
  // imports-actualizacion-diaria-y-multirregistro-spec.md §B.1.3 (B-D4).
  detalle      String?  @db.Text
  deudor       deudor   @relation(fields: [deudorId], references: [id], map: "Factura_deudorId_fkey")

  @@unique([deudorId, nroFactura], map: "Factura_deudorId_nroFactura_key")
}

model importerror {
  id        Int      @id @default(autoincrement())
  remesaId  Int
  rowNumber Int
  rawRow    Json
  errorMsg  String   @db.Text
  createdAt DateTime @default(now())
  remesa    remesa   @relation(fields: [remesaId], references: [id], map: "ImportError_remesaId_fkey")

  @@index([remesaId, rowNumber], map: "ImportError_remesaId_rowNumber_idx")
}

model jobimport {
  id         Int              @id @default(autoincrement())
  remesaId   Int
  estado     jobimport_estado @default(PENDIENTE)
  progreso   Int              @default(0)
  log        String?
  createdAt  DateTime         @default(now())
  finishedAt DateTime?
  remesa     remesa           @relation(fields: [remesaId], references: [id], map: "JobImport_remesaId_fkey")

  @@index([remesaId], map: "JobImport_remesaId_fkey")
}

model pago {
  id               Int       @id @default(autoincrement())
  deudorId         Int
  fecha            DateTime
  importe          Float
  origenArchivo    String?
  observacion      String?
  origen           String?   // 'MANUAL' | 'IMPORT_PAGOS' | 'IMPORT_ACTUALIZACION' | 'CONVENIO'
  usuarioId        Int?
  confirmadoImport Boolean   @default(false)
  confirmadoEn     DateTime?
  deudor           deudor    @relation(fields: [deudorId], references: [id], map: "Pago_deudorId_fkey")
  usuario          usuario?  @relation("PagoUsuario", fields: [usuarioId], references: [id])

  @@index([deudorId], map: "Pago_deudorId_fkey")
  @@index([fecha], map: "Pago_fecha_idx")
  @@index([deudorId, fecha], map: "Pago_deudorId_fecha_idx")
  @@index([deudorId, origen, confirmadoImport], map: "Pago_dedup_idx")
}

model promesa_pago {
  id                  Int        @id @default(autoincrement())
  deudorId            Int
  usuarioId           Int?
  fechaPromesa        DateTime
  monto               Float?
  estado              String     @default("VIGENTE") // VIGENTE | CUMPLIDA | INCUMPLIDA | ANULADA
  cambioSit020        Boolean    @default(false)
  situacionAnteriorId Int?
  pagosAlCrear        Float      @default(0)
  observacion         String?
  createdAt           DateTime   @default(now())
  cerradaEn           DateTime?
  deudor              deudor     @relation(fields: [deudorId], references: [id])
  usuario             usuario?   @relation("PromesaUsuario", fields: [usuarioId], references: [id])
  situacionAnterior   parametro? @relation("PromesaSituacionAnterior", fields: [situacionAnteriorId], references: [id])

  @@index([deudorId])
  @@index([estado, fechaPromesa])
  @@index([estado])
}

model parametro {
  id                          Int                 @id @default(autoincrement())
  grupo                       String
  clave                       String              @unique(map: "Parametro_clave_key")
  descripcion                 String
  padreId                     Int?
  categoria                   String?
  esGlobal                    Boolean             @default(true)
  activo                      Boolean             @default(true)
  parametroPadre              parametro?          @relation("CondicionParametro", fields: [padreId], references: [id])
  subParametros               parametro[]         @relation("CondicionParametro")
  deudoresConEstaGestion      deudor[]            @relation("DeudorEstadoGestion")
  deudoresConGestionPrevia    deudor[]            @relation("DeudorEstadoGestionPrevio")
  deudoresConEstaSituacion    deudor[]            @relation("DeudorEstadoSituacion")
  deudoresConEsteMotivoNoPago deudor[]            @relation("DeudorMotivoNoPago")
  empresas                    empresa_parametro[]
  plantillasConSituacion      plantillaimport[]   @relation("PlantillaDefaultSituacion")
  plantillasConGestion        plantillaimport[]   @relation("PlantillaDefaultGestion")
  llamadas                    llamada_neotel[]    @relation("LlamadaSubcategoria")
  promesasComoAnterior        promesa_pago[]      @relation("PromesaSituacionAnterior")
}

model empresa_parametro {
  empresaId      Int
  parametroId    Int
  nombreOverride String?
  activo         Boolean   @default(true)
  empresa        empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  parametro      parametro @relation(fields: [parametroId], references: [id], onDelete: Cascade)

  @@id([empresaId, parametroId])
  @@index([empresaId])
  @@index([parametroId])
}

model plantillaimport {
  id                       Int                       @id @default(autoincrement())
  empresaId                Int
  nombre                   String
  categoria                plantillaimport_categoria
  version                  Int                       @default(1)
  activo                   Boolean                   @default(true)
  separador                String                    @default("|")
  tieneHeader              Boolean                   @default(false)
  mappingJson              Json
  defaultEstadoSituacionId Int?
  defaultEstadoGestionId   Int?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  empresa                  empresa                   @relation(fields: [empresaId], references: [id], map: "PlantillaImport_empresaId_fkey")
  defaultEstadoSituacion   parametro?                @relation("PlantillaDefaultSituacion", fields: [defaultEstadoSituacionId], references: [id], onDelete: SetNull)
  defaultEstadoGestion     parametro?                @relation("PlantillaDefaultGestion", fields: [defaultEstadoGestionId], references: [id], onDelete: SetNull)
  remesa                   remesa[]

  @@unique([empresaId, nombre, version], map: "unique_empresa_nombre_version")
  @@index([empresaId, categoria], map: "PlantillaImport_empresaId_categoria_idx")
  @@index([defaultEstadoSituacionId])
  @@index([defaultEstadoGestionId])
}

model remesa {
  id               Int                  @id @default(autoincrement())
  empresaId        Int
  nombre           String
  archivo          String?
  estadoCarga      String?
  cantidadDeudores Int?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  numeroRemesa     String
  archivoHash      String?
  categoria        remesa_categoria?
  errFilas         Int                  @default(0)
  estadoProceso    remesa_estadoProceso @default(PENDIENTE)
  okFilas          Int                  @default(0)
  plantillaId      Int?
  totalFilas       Int                  @default(0)
  hoja             String?
  fechaVencimiento DateTime?
  validarDomicilios Boolean             @default(false)
  politicaId       Int?
  usuarioCreadorId Int?                 @map("usuarioCreadorId")
  accionRevertidaEn   DateTime?
  accionRevertidaPorId Int?
  deudor           deudor[]
  importerror      importerror[]
  jobimport        jobimport[]
  empresa          empresa              @relation(fields: [empresaId], references: [id], map: "Remesa_empresaId_fkey")
  plantilla        plantillaimport?     @relation(fields: [plantillaId], references: [id], map: "Remesa_plantillaId_fkey")
  politica         politica?            @relation(fields: [politicaId], references: [id])
  usuarioCreador   usuario?             @relation("RemesaUsuarioCreador", fields: [usuarioCreadorId], references: [id], onDelete: SetNull)

  @@unique([empresaId, numeroRemesa], map: "Remesa_empresaId_numeroRemesa_key")
  @@index([empresaId, categoria], map: "Remesa_empresaId_categoria_idx")
  @@index([plantillaId], map: "Remesa_plantillaId_fkey")
  @@index([politicaId])
  @@index([usuarioCreadorId])
}

model transaccion {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  usuarioId Int?
  empresaId Int?

  modulo    String  @default("SISTEMA")
  entidad   String
  entidadId String?
  tipo      String
  severidad String  @default("INFO")
  estado    String  @default("OK")

  deudorId     Int?
  recursoTexto String?
  resumen      String?
  data         Json?

  ip        String?
  userAgent String?

  deudor  deudor?  @relation(fields: [deudorId], references: [id], map: "Transaccion_deudorId_fkey")
  usuario usuario? @relation(fields: [usuarioId], references: [id], map: "Transaccion_usuarioId_fkey")
  empresa empresa? @relation(fields: [empresaId], references: [id], map: "Transaccion_empresaId_fkey")

  @@index([createdAt])
  @@index([modulo, createdAt])
  @@index([empresaId, createdAt])
  @@index([deudorId, createdAt], map: "Transaccion_deudorId_createdAt_idx")
  @@index([entidad, entidadId], map: "Transaccion_entidad_entidadId_idx")
  @@index([tipo, createdAt], map: "Transaccion_tipo_createdAt_idx")
  @@index([usuarioId, createdAt], map: "Transaccion_usuarioId_createdAt_idx")
  @@index([severidad, createdAt])
  @@index([estado, createdAt])
}

model rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  permisos Json
  creadoAt DateTime  @default(now())
  usuarios usuario[]

  @@map("rol")
}

model usuario {
  id             Int                 @id @default(autoincrement())
  googleId       String?             @unique(map: "Usuario_googleId_key")
  nombre         String
  email          String              @unique(map: "Usuario_email_key")
  avatarUrl      String?
  rol            String              @default("usuario")
  rolId          Int?
  activo         Boolean             @default(true)
  legajo         String?             @unique(map: "Usuario_legajo_key")
  dni            String?             @unique(map: "Usuario_dni_key")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime
  rolObj            rol?                @relation(fields: [rolId], references: [id])
  comentario        comentario[]
  transaccion       transaccion[]
  convenios         convenio[]
  plantillas        plantilla_reporte[] @relation("PlantillaCreadoPor")
  ejecuciones       ejecucion_reporte[] @relation("EjecucionUsuario")
  notificaciones    Notificacion[]
  remesasCreadas    remesa[]            @relation("RemesaUsuarioCreador")
  enviosEmail       envio_email[]
  mapeosEmail       email_template_variable_mapeo[]
  agenteTelefonia   agente_telefonia?
  callbacksAgendados callback_neotel[]
  pagosManuales     pago[]              @relation("PagoUsuario")
  promesas          promesa_pago[]      @relation("PromesaUsuario")

  @@index([rolId])
}

enum jobimport_estado {
  PENDIENTE
  VALIDANDO
  PROCESANDO
  FINALIZADA
  FALLIDA
}

enum remesa_estadoProceso {
  PENDIENTE
  VALIDANDO
  PROCESANDO
  FINALIZADA
  FALLIDA
}

/// Snapshot de cambios de un import de ACCIONES masivas, para poder revertir (undo).
/// Un registro por cambio: UPDATE guarda {campo: valorViejo}; DELETE guarda la fila completa
/// borrada; INSERT guarda null y `entidadId` = id creado (se borra al revertir).
model accion_masiva_snapshot {
  id           BigInt   @id @default(autoincrement())
  remesaId     Int
  entidad      String   // 'deudor' | 'contacto' | 'comentario'
  entidadId    Int
  accion       String   // 'UPDATE' | 'DELETE' | 'INSERT'
  datosPrevios Json?
  createdAt    DateTime @default(now())

  @@index([remesaId])
}

enum plantillaimport_categoria {
  DEUDORES
  FACTURAS
  ENRIQUECIMIENTO
  PAGOS
  CONTACTOS
  DEUDORES_Y_FACTURAS
  ACTUALIZACIONES
  ACCIONES
  MULTIRREGISTRO
}

enum remesa_categoria {
  DEUDORES
  FACTURAS
  ENRIQUECIMIENTO
  PAGOS
  CONTACTOS
  DEUDORES_Y_FACTURAS
  ACTUALIZACIONES
  ACCIONES
  MULTIRREGISTRO
}

model politica {
  id           Int      @id @default(autoincrement())
  empresaId    Int
  nombre       String
  descripcion  String?  @db.Text
  formasDePago String?  @db.Text
  tipoAtencion String?  @db.Text
  datosExtra   Json?
  activa       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  empresa      empresa  @relation(fields: [empresaId], references: [id])
  remesas      remesa[]

  @@index([empresaId])
}

model convenio {
  id            Int              @id @default(autoincrement())
  deudorId      Int
  usuarioId     Int?
  tipo          String
  estado        String           @default("ACTIVO")
  montoTotal    Float
  cantCuotas    Int
  montoCuota    Float
  fechaInicio   DateTime
  observaciones String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deudor        deudor           @relation(fields: [deudorId], references: [id])
  usuario       usuario?         @relation(fields: [usuarioId], references: [id])
  cuotas        cuota_convenio[]

  @@index([deudorId])
  @@index([usuarioId])
}

model cuota_convenio {
  id               Int       @id @default(autoincrement())
  convenioId       Int
  nroCuota         Int
  fechaVencimiento DateTime
  importe          Float
  estado           String    @default("PENDIENTE")
  fechaPago        DateTime?
  convenio         convenio  @relation(fields: [convenioId], references: [id], onDelete: Cascade)

  @@index([convenioId])
}

model formato_telefono {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?
  patron      String
  activo      Boolean @default(true)
}

model plantilla_reporte {
  id              Int                 @id @default(autoincrement())
  nombre          String
  descripcion     String?             @db.Text
  raiz            String              @default("deudor")
  empresaId       Int?
  activo          Boolean             @default(true)
  definicion      Json
  formatoSalida   String
  opcionesFormato Json?
  creadoPorId     Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  empresa         empresa?            @relation("PlantillaEmpresa", fields: [empresaId], references: [id])
  creadoPor       usuario?            @relation("PlantillaCreadoPor", fields: [creadoPorId], references: [id])
  ejecuciones     ejecucion_reporte[]

  @@index([empresaId])
  @@index([activo])
  @@index([creadoPorId])
}

model ejecucion_reporte {
  id              Int               @id @default(autoincrement())
  plantillaId     Int
  usuarioId       Int
  empresaId       Int?
  filtrosUsados   Json
  totalFilas      Int?
  filasProcesadas Int               @default(0)
  progreso        Int               @default(0)
  estado          String            @default("PENDIENTE")
  modo            String            @default("SYNC")
  formato         String?
  archivoPath     String?
  archivoTamano   Int?
  errorMsg        String?           @db.Text
  cancelado       Boolean           @default(false)
  duracionMs      Int?
  jobId           String?
  createdAt       DateTime          @default(now())
  iniciadoEn      DateTime?
  finishedAt      DateTime?
  plantilla       plantilla_reporte @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  usuario         usuario           @relation("EjecucionUsuario", fields: [usuarioId], references: [id])

  @@index([plantillaId])
  @@index([usuarioId, createdAt])
  @@index([estado])
  @@index([empresaId])
}

enum TipoNotificacion {
  IMPORTACION_INICIADA
  IMPORTACION_FINALIZADA
  IMPORTACION_ERROR
  REPORTE_LISTO
  REPORTE_ERROR
  CONVENIO_VENCIDO
  SISTEMA
}

enum EntidadTipo {
  REMESA
  REPORTE_EJECUCION
  CONVENIO
  GENERICO
}

model Notificacion {
  id            Int              @id @default(autoincrement())
  usuarioId     Int
  tipo          TipoNotificacion
  entidadTipo   EntidadTipo?
  entidadId     Int?
  titulo        String           @db.VarChar(200)
  mensaje       String           @db.VarChar(1000)
  payload       Json?
  leida         Boolean          @default(false)
  leidaEn       DateTime?
  rutaAccion    String?          @db.VarChar(500)
  creadoEn      DateTime         @default(now())
  actualizadoEn DateTime         @updatedAt
  usuario       usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, leida, creadoEn(sort: Desc)])
  @@index([entidadTipo, entidadId])
  @@index([creadoEn])
  @@map("notificacion")
}

model envio_email {
  id               Int      @id @default(autoincrement())
  deudorId         Int
  empresaId        Int
  usuarioId        Int
  smtpId           Int
  templateId       Int
  destinatarios    String   @db.Text
  asunto           String   @db.VarChar(500)
  variables        Json
  archivosNombres  Json
  senderReporteIds Json
  estado           String   @default("ENVIADO") @db.VarChar(32)
  error            String?  @db.Text
  creadoAt         DateTime @default(now())
  deudor           deudor   @relation(fields: [deudorId], references: [id], onDelete: Cascade)
  empresa          empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario          usuario  @relation(fields: [usuarioId], references: [id])

  @@index([deudorId, creadoAt])
  @@index([empresaId, creadoAt])
  @@map("envio_email")
}

model email_template_variable_mapeo {
  id            Int      @id @default(autoincrement())
  templateId    Int
  variable      String   @db.VarChar(120)
  fuenteTipo    String   @db.VarChar(32)
  fuenteClave   String   @db.VarChar(180)
  usuarioId     Int?
  creadoAt      DateTime @default(now())
  actualizadoAt DateTime @updatedAt
  usuario       usuario? @relation(fields: [usuarioId], references: [id])

  @@unique([templateId, variable], map: "email_tpl_var_mapeo_template_variable_key")
  @@index([templateId])
  @@map("email_template_variable_mapeo")
}

// ─────────────────────────────────────────────────────────────────────────────
// TELEFONÍA NEOTEL
// ─────────────────────────────────────────────────────────────────────────────

model agente_telefonia {
  id             Int      @id @default(autoincrement())
  usuarioId      Int      @unique
  usuarioNeotel  String
  claveNeotelEnc String   @db.Text
  device         String
  sipAuthUser    String
  sipPasswordEnc String   @db.Text
  sipDisplayName String?
  habilitado     Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  usuario        usuario  @relation(fields: [usuarioId], references: [id])
  sesiones       sesion_agente_neotel[]

  @@map("AgenteTelefonia")
}

model sesion_agente_neotel {
  id             Int       @id @default(autoincrement())
  agenteId       Int
  usuarioNeotel  String
  device         String
  loginAt        DateTime  @default(now())
  logoutAt       DateTime?
  ipCliente      String?
  userAgent      String?   @db.Text
  causaCierre    String?
  agente         agente_telefonia     @relation(fields: [agenteId], references: [id])
  campañasSesion campaña_sesion_neotel[]
  estadosEventos estado_agente_evento[]
  llamadas       llamada_neotel[]

  @@index([agenteId, loginAt])
  @@index([loginAt])
  @@map("SesionAgenteNeotel")
}

model campaña_neotel {
  id          Int      @id @default(autoincrement())
  idNeotel    Int      @unique
  nombre      String
  descripcion String?
  empresaId   Int?
  activa      Boolean  @default(true)
  predictiva  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  empresa     empresa? @relation(fields: [empresaId], references: [id])
  sesiones    campaña_sesion_neotel[]
  llamadas    llamada_neotel[]

  @@index([empresaId])
  @@map("CampaniaNeotel")
}

model campaña_sesion_neotel {
  id        Int       @id @default(autoincrement())
  sesionId  Int
  campañaId Int
  enteredAt DateTime  @default(now())
  leftAt    DateTime?
  sesion    sesion_agente_neotel @relation(fields: [sesionId], references: [id])
  campaña   campaña_neotel       @relation(fields: [campañaId], references: [id])

  @@index([sesionId])
  @@index([campañaId, enteredAt])
  @@map("CampaniaSesionNeotel")
}

model motivo_pausa_neotel {
  id                    Int      @id @default(autoincrement())
  subtipoNeotel         Int      @unique
  nombre                String
  descripcion           String?
  contabilizaProductivo Boolean  @default(false)
  orden                 Int      @default(0)
  activo                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  eventos               estado_agente_evento[]

  @@map("MotivoPausaNeotel")
}

model estado_agente_evento {
  id            Int       @id @default(autoincrement())
  sesionId      Int
  estado        String
  motivoPausaId Int?
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  duracionSeg   Int?
  origen        String
  sesion        sesion_agente_neotel  @relation(fields: [sesionId], references: [id])
  motivoPausa   motivo_pausa_neotel?  @relation(fields: [motivoPausaId], references: [id])

  @@index([sesionId, startedAt])
  @@index([estado, startedAt])
  @@map("EstadoAgenteEvento")
}

model llamada_neotel {
  id                 Int       @id @default(autoincrement())
  sesionId           Int
  campañaId          Int?
  deudorId           Int?
  contactoId         Int?
  baseNeotel         Int?
  idContactoNeotel   String?
  direccion          String
  telefono           String
  estado             String
  ringedAt           DateTime?
  answeredAt         DateTime?
  endedAt            DateTime?
  duracionSeg        Int?
  causaFin           String?
  grabacionRequerida Boolean   @default(false)
  grabacionEstado    String?
  recordingUrl       String?
  subcategoriaId     Int?
  notas              String?   @db.Text
  rawDataNeotel      Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sesion             sesion_agente_neotel  @relation(fields: [sesionId], references: [id])
  campaña            campaña_neotel?       @relation(fields: [campañaId], references: [id])
  deudor             deudor?               @relation(fields: [deudorId], references: [id])
  contacto           contacto?             @relation(fields: [contactoId], references: [id])
  subcategoria       parametro?            @relation("LlamadaSubcategoria", fields: [subcategoriaId], references: [id])
  callbackAgendado   callback_neotel?

  @@index([sesionId, createdAt])
  @@index([deudorId, createdAt])
  @@index([estado])
  @@index([campañaId, createdAt])
  @@map("LlamadaNeotel")
}

model callback_neotel {
  id              Int       @id @default(autoincrement())
  llamadaId       Int       @unique
  fechaAgenda     DateTime
  telefono        String
  usuarioAgendaId Int?
  llamada         llamada_neotel @relation(fields: [llamadaId], references: [id])
  usuarioAgenda   usuario?       @relation(fields: [usuarioAgendaId], references: [id])

  @@index([fechaAgenda])
  @@map("CallbackNeotel")
}

model neotel_evento_log {
  id             BigInt    @id @default(autoincrement())
  sesionId       Int?
  usuarioNeotel  String?
  raw            String    @db.Text
  tipoParsed     String?
  llamadaId      Int?
  procesadoAt    DateTime  @default(now())
  errorParseo    String?

  @@index([sesionId, procesadoAt])
  @@index([procesadoAt])
  @@map("NeotelEventoLog")
}
