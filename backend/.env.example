# Database
DATABASE_URL="mysql://user:password@localhost:3306/amsa_gestion"

# App
PORT=3001

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Reportes v2 — async (Fase 6)
# Umbral de filas estimadas para decidir entre ejecución sync vs async
REPORTES_SYNC_THRESHOLD=5000
# Tamaño de chunk para streaming con cursor de Prisma
REPORTES_CHUNK_SIZE=1000
# Límite máximo absoluto de filas en memoria (aborta con mensaje claro si se supera)
REPORTES_HARD_LIMIT=200000
# Carpeta raíz donde se guardan los archivos generados (relativa o absoluta)
REPORTES_STORAGE_PATH=./storage
# Días de retención antes del cleanup automático diario
REPORTES_RETENTION_DAYS=30

# === Importaciones ===
# Filas que el runner procesa por lote. En ACTUALIZACIONES es además el tamaño del IN (...) del
# prefetch y de la transacción de updates: subirlo baja la cantidad de queries de un archivo grande,
# pero alarga la transacción (más tiempo de locks) y hace menos granular el progreso en la UI.
# Default 1000, acotado a [1, 5000].
IMPORTS_BATCH_SIZE=1000
# Tope de tiempo (ms) para hablar con la cola de imports al confirmar o borrar una carga. Con Redis caído
# BullMQ no falla: espera. Default 10000, bien por debajo de los 60 s del ALB.
IMPORTS_QUEUE_TIMEOUT_MS=10000
# Cada cuánto (ms) el reloj del ProgresoTracker vuelca el progreso de una carga a la base y lo emite por
# socket. Entre volcados el latido de la carga se escribe cada 15 s (constante). Default 1000, acotado a
# [250, 10000]; un valor inválido cae al default o a la cota.
IMPORTS_PROGRESO_INTERVALO_MS=1000
# Minutos sin latido para que el reaper cierre una carga como FALLIDA (el worker murió: deploy, corte,
# memoria). La pasada que supera el umbral solo anota la sospecha y la siguiente cierra: el cierre llega
# entre umbral + 1 y umbral + 2 minutos después del último latido (6 a 7 con el default). Una carga NUNCA se
# re-ejecuta sola. Default 5, acotado a [3, 120].
IMPORTS_LATIDO_UMBRAL_MIN=5
# Antigüedad (horas) de una vista previa sin confirmar para que el reaper de borradores la borre (cron
# diario 04:30 del reloj del contenedor). Solo borra remesas PENDIENTE/VALIDANDO sin casos y sin
# confirmar; no borra archivos. Default 24, acotado a [1, 720].
IMPORTS_BORRADOR_TTL_HORAS=24
# Llave de emergencia: apaga los DOS crons del reaper (cargas colgadas y borradores). Solo la apagan los
# valores 1, true, si, sí, yes, on, y o s (sin distinguir mayúsculas); vacío, false o 0 la dejan encendida.
IMPORTS_REAPER_DESACTIVADO=
# Casos máximos de una remesa que se puede eliminar desde la pantalla. Más que esto el borrado responde 400
# "demasiado grande, avisá a soporte" sin tocar nada. La cota superior (65000) es un límite real de MySQL: con 65536
# casos o más, el conteo de comentarios tira "too many placeholders". Default 60000, acotado a [1000, 65000].
IMPORTS_BORRADO_MAX_CASOS=60000

# === Neotel (integración telefonía) ===
# URL base del webservice ASMX de Neotel (sin /neoapi/...)
NEOTEL_API_HOST=http://200.5.98.203
# Timeout HTTP en ms (default 8000)
NEOTEL_TIMEOUT_MS=8000
# Reintentos en errores 5xx/timeout (default 3)
NEOTEL_RETRY_ATTEMPTS=3
# Dominio SIP de Asterisk (sin puerto)
NEOTEL_SIP_DOMAIN=200.5.98.203
# URL WSS de Asterisk para JsSIP
NEOTEL_WSS_URL=wss://200.5.98.203:8089/ws
# Clave AES-256-GCM para cifrar credenciales SIP almacenadas en la DB.
# Generar con: openssl rand -hex 32
# NUNCA commitear el valor real. Rotar esta key requiere re-cifrar con encrypt-sip-passwords.ts
NEOTEL_SIP_ENCRYPTION_KEY=

# === Consolidación de situación ===
# Porcentaje de tolerancia para considerar un deudor como Cancelado (SIT-050).
# Si sum(pagos) >= montoTotal * (1 - tolerancia) se asigna SIT-050.
# Rango aceptado: [0, 0.05]. Default: 0.01 (1%). Fuera de rango falla el bootstrap.
CONSOLIDACION_TOLERANCIA_PCT=0.01

# === Consolidación de situación — cancelación por clave de pago (multiclaves, fase 4a) ===
# Cuánto puede faltar (en CENTAVOS) para dar una clave de pago por cancelada. 100 = $ 1,00, que es
# lo que se pierde cuando el archivo del cedente trunca centavos. Rango [0, 1000]. Fuera de rango
# falla el bootstrap.
CONSOLIDACION_TOLERANCIA_CLAVE_CENTAVOS=100
# SUMA (default): la clave se puede pagar en varias partes que suman el importe. PAGO_UNICO: hace
# falta un solo pago que alcance. Cualquier otro valor falla el bootstrap.
CONSOLIDACION_CLAVE_MODO=SUMA

# === Claves de pago (multiclaves) ===
# Ruta a un logo de Personal alternativo (p. ej. en el volumen de uploads), para reemplazar el
# placeholder del repo sin rehacer el deploy. Se lee una vez al iniciar el proceso — reemplazar el
# archivo requiere reiniciar. Si no está definida o el archivo no existe, el cupón sale con el
# texto "Personal" en su lugar (nunca falla por el logo).
MULTICLAVES_LOGO_PATH=

# === Logging ===
# Nivel mínimo de log: verbose | debug | log | warn | error
LOG_LEVEL=log
# Directorio de logs (relativo al proceso o absoluto)
LOG_DIR=./logs
# Tamaño máximo por archivo antes de rotar (ej: 20m, 100k)
LOG_MAX_SIZE=20m
# Días de retención de archivos rotados
LOG_RETENTION_DAYS=14
# Activar query-level logging de Prisma (true/false) — solo para debugging puntual
LOG_PRISMA_QUERIES=false
