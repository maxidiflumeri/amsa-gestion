# Database
DATABASE_URL="mysql://user:password@localhost:3306/amsa_gestion"

# App
PORT=3001

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Reportes v2 — async (Fase 6)
# Umbral de filas estimadas para decidir entre ejecución sync vs async
REPORTES_V2_SYNC_THRESHOLD=5000
# Tamaño de chunk para streaming con cursor de Prisma
REPORTES_V2_CHUNK_SIZE=1000
# Límite máximo absoluto de filas en memoria (aborta con mensaje claro si se supera)
REPORTES_V2_HARD_LIMIT=200000
# Carpeta raíz donde se guardan los archivos generados (relativa o absoluta)
REPORTES_V2_STORAGE_PATH=./storage
# Días de retención antes del cleanup automático diario
REPORTES_V2_RETENTION_DAYS=30

# === Neotel (integración telefonía) ===
# URL base del webservice ASMX de Neotel (sin /neoapi/...)
NEOTEL_API_HOST=http://200.5.98.203
# Timeout HTTP en ms (default 8000)
NEOTEL_TIMEOUT_MS=8000
# Reintentos en errores 5xx/timeout (default 3)
NEOTEL_RETRY_ATTEMPTS=3
# Dominio SIP de Asterisk (sin puerto)
NEOTEL_SIP_DOMAIN=200.5.98.203
# URL WSS de Asterisk para JsSIP
NEOTEL_WSS_URL=wss://200.5.98.203:8089/ws
# Clave AES-256-GCM para cifrar credenciales SIP almacenadas en la DB.
# Generar con: openssl rand -hex 32
# NUNCA commitear el valor real. Rotar esta key requiere re-cifrar con encrypt-sip-passwords.ts
NEOTEL_SIP_ENCRYPTION_KEY=
