# Database
DATABASE_URL="mysql://user:password@localhost:3306/amsa_gestion"

# App
PORT=3001

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Reportes v2 — async (Fase 6)
# Umbral de filas estimadas para decidir entre ejecución sync vs async
REPORTES_V2_SYNC_THRESHOLD=5000
# Tamaño de chunk para streaming con cursor de Prisma
REPORTES_V2_CHUNK_SIZE=1000
# Límite máximo absoluto de filas en memoria (aborta con mensaje claro si se supera)
REPORTES_V2_HARD_LIMIT=200000
# Carpeta raíz donde se guardan los archivos generados (relativa o absoluta)
REPORTES_V2_STORAGE_PATH=./storage
# Días de retención antes del cleanup automático diario
REPORTES_V2_RETENTION_DAYS=30
